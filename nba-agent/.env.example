# === Required ===
# OpenRouter or OpenAI API key for the LLM backend
OPENROUTER_API_KEY=
# OPENAI_API_KEY=             # fallback if OPENROUTER_API_KEY is unset

# === Database ===
# Path to the DuckDB warehouse (default: ../data/nba-data.duckdb)
DATABASE_PATH=../data/nba-data.duckdb

# === Server ===
# Bind address and port (default: 0.0.0.0:3000)
BIND_ADDRESS=0.0.0.0
PORT=3000

# === Agent ===
# OpenRouter model identifier (default: qwen/qwen3.7-flash)
MODEL=qwen/qwen3.7-flash
# Fallback model if primary fails (optional)
# FALLBACK_MODEL=anthropic/claude-3-haiku
# Max reasoning loop iterations per turn (default: 12)
MAX_ITERATIONS=12
# OpenRouter API base URL (default: https://openrouter.ai/api/v1/chat/completions)
# OPENROUTER_BASE_URL=

# === Sessions ===
# Path for persisted session JSON (default: data/sessions.json)
SESSIONS_PATH=data/sessions.json

# === Security ===
# Bearer token for /api/* auth; unset = unauthenticated dev mode
# API_KEY=
# Comma-separated CIDRs for trusted reverse proxies (X-Forwarded-For)
# TRUSTED_PROXIES=
# Comma-separated allowed CORS origins; unset = permissive dev mode
# CORS_ALLOWED_ORIGINS=

# === Limits ===
# Max rows returned per SQL query (default: 50)
ROW_CAP=50
# DuckDB per-instance memory cap (default: 2GB)
DUCKDB_MEMORY_LIMIT=2GB
# SQL result cache max entries (default: 200)
CACHE_MAX_CAPACITY=200
# SQL result cache TTL in seconds (default: 60)
CACHE_TTL_SECS=60
